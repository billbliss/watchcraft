{
  "name": "watchcraft",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @watchcraft/web",
    "desktop:build": "npm run build --workspace @watchcraft/desktop",
    "desktop:build:beta": "npm run build:beta --workspace @watchcraft/desktop",
    "desktop:build:linux": "npm exec --workspace @watchcraft/desktop -- tauri build --bundles deb,appimage",
    "desktop:build:windows": "npm exec --workspace @watchcraft/desktop -- tauri build --bundles nsis,msi",
    "desktop:dev": "npm run dev --workspace @watchcraft/desktop",
    "desktop:smoke": "npm run desktop:smoke:referenced && npm run desktop:smoke:managed",
    "desktop:smoke:referenced": "node scripts/desktop-playback-smoke.mjs --delivery=referenced-local",
    "desktop:smoke:managed": "node scripts/desktop-playback-smoke.mjs --delivery=managed-local",
    "dev": "npm run dev --workspace @watchcraft/web",
    "test": "npm run test --workspaces --if-present && npm run test:release && npm run test:site",
    "test:release": "node --test scripts/release-metadata.test.mjs",
    "test:site": "node --test scripts/youtube-player-bridge.test.mjs scripts/site-directory.test.mjs",
    "typecheck": "npm run typecheck --workspace @watchcraft/web"
  },
  "engines": {
    "node": ">=22"
  }
}
