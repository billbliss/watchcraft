{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watchcraft.dev/schemas/terminology-resolution-v1.json",
  "title": "Watchcraft terminology resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "project",
    "model",
    "prompt_version",
    "source_hash",
    "resolutions",
    "stats",
    "provenance"
  ],
  "properties": {
    "kind": { "const": "watchcraft.terminology-resolution" },
    "schema_version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "revision"],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "metadata": { "type": "object" }
      }
    },
    "model": { "type": "string", "minLength": 1 },
    "prompt_version": { "type": "integer", "minimum": 1 },
    "source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "resolutions": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolution" }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_terms", "proposed_changes", "automatic_safe", "needs_review"],
      "properties": {
        "observed_terms": { "type": "integer", "minimum": 0 },
        "proposed_changes": { "type": "integer", "minimum": 0 },
        "automatic_safe": { "type": "integer", "minimum": 0 },
        "needs_review": { "type": "integer", "minimum": 0 }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store",
        "algorithm",
        "digest",
        "byte_length",
        "media_type",
        "artifact_kind",
        "schema",
        "key"
      ],
      "properties": {
        "store": { "const": "r2" },
        "algorithm": { "const": "sha256" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byte_length": { "type": "integer", "minimum": 1 },
        "media_type": { "const": "application/json" },
        "artifact_kind": { "type": "string", "minLength": 1 },
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "integer", "minimum": 1 }
          }
        },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "confidence"],
      "properties": {
        "term": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution_id",
        "observed_forms",
        "canonical_term",
        "display_label",
        "classification",
        "confidence",
        "rationale",
        "affected_items",
        "evidence",
        "alternatives",
        "disposition"
      ],
      "properties": {
        "resolution_id": { "type": "string", "minLength": 1 },
        "observed_forms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "canonical_term": { "type": "string", "minLength": 1 },
        "display_label": { "type": "string", "minLength": 1 },
        "classification": {
          "enum": [
            "orthographic-normalization",
            "domain-correction",
            "possible-acoustic-confusion"
          ]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "affected_items": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "alternatives": {
          "type": "array",
          "items": { "$ref": "#/$defs/alternative" }
        },
        "disposition": { "enum": ["automatic-safe", "needs-review"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handler_id",
        "handler_version",
        "job_id",
        "spec_sha256",
        "plan_job_id",
        "plan_artifact_sha256",
        "plan_hash",
        "logical_task_id",
        "items",
        "timing"
      ],
      "properties": {
        "handler_id": { "type": "string", "minLength": 1 },
        "handler_version": { "type": "string", "minLength": 1 },
        "job_id": { "type": "string", "minLength": 1 },
        "spec_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "plan_job_id": { "type": "string", "minLength": 1 },
        "plan_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "logical_task_id": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "source_title",
              "video",
              "transcript_digest",
              "analysis_digest",
              "transcript",
              "analysis"
            ],
            "properties": {
              "item_id": { "type": "string", "minLength": 1 },
              "source_title": { "type": "string", "minLength": 1 },
              "video": { "type": "string", "minLength": 1 },
              "transcript_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "analysis_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "transcript": { "$ref": "#/$defs/artifactReference" },
              "analysis": { "$ref": "#/$defs/artifactReference" }
            }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dependency_fetch_ms", "resolution_ms", "handler_ms"],
          "properties": {
            "dependency_fetch_ms": { "type": "integer", "minimum": 0 },
            "resolution_ms": { "type": "integer", "minimum": 0 },
            "handler_ms": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
