#!/usr/bin/env python3
"""Command-line launcher for Watchcraft collection authoring."""

import os
import sys
from pathlib import Path


launcher_path = Path(__file__).resolve()
venv_root = launcher_path.parent / ".venv"
venv_python = venv_root / "bin" / "python"
if venv_python.is_file() and Path(sys.prefix).resolve() != venv_root.resolve():
    os.execv(
        str(venv_python),
        [str(venv_python), str(launcher_path), *sys.argv[1:]],
    )

from watchcraft_author import entrypoint


if __name__ == "__main__":
    raise SystemExit(entrypoint())
